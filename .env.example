# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Enable ONLY for a loopback-bound personal preview; never on a public deployment.
HEYQUIZ_LOCAL_MODE=0
# Set all three to use Supabase Auth, Postgres and private media storage.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: required only when publishing forms containing a CAPTCHA field.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Local storage location; omitted means .heyquiz-data
HEYQUIZ_DATA_DIR=

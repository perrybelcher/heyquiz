# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Enable ONLY for a loopback-bound personal preview; never on a public deployment.
HEYQUIZ_LOCAL_MODE=0
# Set all three to use Supabase Auth, Postgres and private media storage.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy keys remain supported as a fallback.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: required only when publishing forms containing a CAPTCHA field.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Local storage location; omitted means .heyquiz-data
HEYQUIZ_DATA_DIR=
# Optional separate stable credential-encryption secret (32+ characters).
# If omitted, SESSION_SECRET is used. Changing either active encryption key requires reconnecting destinations.
INTEGRATION_SECRET=
# Required to enable authenticated scheduled integration retries (32+ random characters).
CRON_SECRET=

# Nango HubSpot pilot (server only; never NEXT_PUBLIC_)
NANGO_SECRET_KEY=
NANGO_HUBSPOT_INTEGRATION_ID=hubspot

# Nango integration IDs (each must use the provider documented in docs/nango-providers.md).
NANGO_ACTIVECAMPAIGN_INTEGRATION_ID=
NANGO_KLAVIYO_INTEGRATION_ID=
NANGO_MAILCHIMP_INTEGRATION_ID=
NANGO_KEAP_INTEGRATION_ID=
NANGO_BREVO_INTEGRATION_ID=
NANGO_ZOHO_INTEGRATION_ID=
NANGO_FRESHSALES_INTEGRATION_ID=
NANGO_SALESFORCE_INTEGRATION_ID=
NANGO_TWENTY_INTEGRATION_ID=
